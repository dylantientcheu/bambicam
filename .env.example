# Build-time settings. Leave VITE_RELAY_URL unset for same-origin /relay.
# VITE_RELAY_URL=wss://relay.bambi.cam/relay
# VITE_STUN_URL=stun:stun.cloudflare.com:3478
# An empty VITE_STUN_URL disables STUN for LAN-only operation.

# Docker Compose defaults to STUN off. Set this and rebuild web for an
# across-network default; existing remembered pairings retain their settings.
# BAMBICAM_STUN_URL=stun:stun.cloudflare.com:3478
