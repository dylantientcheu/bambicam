{
  "name": "bambicam",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "relay"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w web",
    "dev:relay": "npm run dev -w relay",
    "build": "npm run build -w web",
    "typecheck": "tsc --noEmit -p web/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts relay/*.test.mjs",
    "test:e2e": "playwright test",
    "smoke:relay": "node scripts/smoke-relay.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
